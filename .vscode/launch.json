{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NavigationIQ (Android)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_android.ps1\""
        },
        {
            "name": "Run Android Emulator",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_emulator.ps1\""
        },
        {
            "name": "Run Android Emulator (Cold Boot)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_emulator.ps1\" -ColdBoot"
        },
        {
            "name": "Run Garmin Simulator",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_emulator.ps1\" -Garmin"
        }
    ]
}
