{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Android Emulator",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_emulator.ps1\"",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run Garmin Simulator",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_emulator.ps1\" -Garmin",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run NavigationIQ on Android",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_android.ps1\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run NavigationIQ on Android Emulator",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/run_android.ps1\" -Target emulator",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Garmin App (Beta .iq)",
            "type": "shell",
            "command": "python \"${workspaceFolder}/build_garmin.py\" beta",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Garmin App (Release .iq)",
            "type": "shell",
            "command": "python \"${workspaceFolder}/build_garmin.py\" release",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
